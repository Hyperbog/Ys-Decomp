; Verified Z80 instruction/data listing. Each row is: OFFSET  BYTES  INTERPRETATION
; The verify.py script compares all row bytes, including padding and dispatch entries.

; Z80 reset vector (ROM offset == CPU address in bank 0)
ResetVector:
0000  F3                 di
0001  ED 56              im 1
0003  C3 89 00           jp Startup
0006  FF FF                                      db 2 × $ff (padding/unclassified)
; RST $08 table-dispatch helper: HL points to a word table; A indexes it
DispatchRst08:
0008  87                 add a,a
0009  85                 add a,l
000A  6F                 ld l,a
000B  30 01              jr nc,$000e
000D  24                 inc h
000E  7E                 ld a,(hl)
000F  23                 inc hl
0010  66                 ld h,(hl)
0011  6F                 ld l,a
0012  E9                 jp (hl)
0013  FF FF FF FF FF                             db 5 × $ff (padding/unclassified)
; RST $18 table lookup: returns target address in HL
TableLookupRst18:
0018  87                 add a,a
0019  85                 add a,l
001A  6F                 ld l,a
001B  30 01              jr nc,$001e
001D  24                 inc h
001E  7E                 ld a,(hl)
001F  23                 inc hl
0020  66                 ld h,(hl)
0021  6F                 ld l,a
0022  C9                 ret
0023  FF FF FF FF FF                             db 5 × $ff (padding/unclassified)
; RST $28 VDP command write helper: outputs E, then D, to port $BF
VdpSetAddressRst28:
0028  F3                 di
0029  7B                 ld a,e
002A  D3 BF              out ($bf),a
002C  7A                 ld a,d
002D  D3 BF              out ($bf),a
002F  FB                 ei
0030  C9                 ret
0031  FF FF FF FF FF FF FF                       db 7 × $ff (padding/unclassified)
; Interrupt-mode-1 vector: reads VDP status port $BF
InterruptMode1Handler:
0038  F5                 push af
0039  DB BF              in a,($bf)
003B  B7                 or a
003C  F2 40 05           jp p,$0540
003F  C3 02 01           jp $0102
WaitForVBlank:
0042  32 21 C0           ld ($c021),a
0045  FB                 ei
0046  3A 21 C0           ld a,($c021)
0049  B7                 or a
004A  20 FA              jr nz,$0046
004C  C9                 ret
; ROM bank 2 call bridge
Bank2InitBridge:
004D  3E 02              ld a,$02
004F  32 FF FF           ld ($ffff),a
0052  CD 42 88           call $8842
0055  C3 C5 0B           jp $0bc5
0058  FF FF FF FF FF FF FF FF FF FF FF FF FF FF  db 14 × $ff (padding/unclassified)
; NMI vector
NmiHandler:
0066  F5                 push af
0067  3A 1F C0           ld a,($c01f)
006A  FE 0D              cp $0d
006C  28 12              jr z,$0080
006E  FE 06              cp $06
0070  28 03              jr z,$0075
0072  F1                 pop af
0073  ED 45              retn
0075  32 20 C0           ld ($c020),a
0078  3E 0D              ld a,$0d
007A  32 1F C0           ld ($c01f),a
007D  F1                 pop af
007E  ED 45              retn
0080  3A 20 C0           ld a,($c020)
0083  32 1F C0           ld ($c01f),a
0086  F1                 pop af
0087  ED 45              retn
; Mapper setup, RAM initialization, entry to main loop
Startup:
0089  31 F0 DF           ld sp,$dff0
008C  21 FC FF           ld hl,$fffc
008F  36 80              ld (hl),$80
0091  23                 inc hl
0092  36 00              ld (hl),$00
0094  23                 inc hl
0095  36 01              ld (hl),$01
0097  23                 inc hl
0098  36 02              ld (hl),$02
009A  AF                 xor a
009B  32 60 DE           ld ($de60),a
009E  3D                 dec a
009F  32 01 C0           ld ($c001),a
00A2  CD 9A 07           call $079a
ClearSystemRam:
00A5  F3                 di
00A6  31 F0 DF           ld sp,$dff0
00A9  21 10 C0           ld hl,$c010
00AC  11 11 C0           ld de,$c011
00AF  01 4F 1E           ld bc,$1e4f
00B2  36 00              ld (hl),$00
00B4  ED B0              ldir
00B6  3E 02              ld a,$02
00B8  32 FF FF           ld ($ffff),a
00BB  CD 03 88           call $8803
00BE  CD 49 07           call $0749
00C1  CD C5 0B           call $0bc5
MainLoop:
00C4  3A 18 C0           ld a,($c018)
00C7  32 31 C0           ld ($c031),a
00CA  3A 1F C0           ld a,($c01f)
00CD  21 D4 00           ld hl,DispatchTable
00D0  CF                 rst $08
00D1  C3 C4 00           jp $00c4
; 20 little-endian jump-table targets; original meaning of states not yet confirmed
DispatchTable:
00D4  FC 00              dw $00fc
00D6  4A 0C              dw $0c4a
00D8  DE 0E              dw $0ede
00DA  23 0F              dw $0f23
00DC  39 0F              dw $0f39
00DE  71 0F              dw $0f71
00E0  C9 0D              dw $0dc9
00E2  05 2C              dw $2c05
00E4  59 44              dw $4459
00E6  70 3F              dw $3f70
00E8  05 38              dw $3805
00EA  CC 38              dw $38cc
00EC  45 3C              dw $3c45
00EE  4D 00              dw $004d
00F0  63 4B              dw $4b63
00F2  39 43              dw $4339
00F4  A8 63              dw $63a8
00F6  07 6C              dw $6c07
00F8  26 6A              dw $6a26
00FA  25 7C              dw $7c25
; Set RAM game-state selector to $01
InitGameState:
00FC  3E 01              ld a,$01
00FE  32 1F C0           ld ($c01f),a
0101  C9                 ret
